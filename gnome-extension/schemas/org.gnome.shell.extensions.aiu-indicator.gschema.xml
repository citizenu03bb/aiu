<!-- Settings of the panel itself. aiu's own settings (providers, key sources)
     stay in config.toml, read and written only through `aiu config`. -->
<schemalist>
  <schema id="org.gnome.shell.extensions.aiu-indicator"
          path="/org/gnome/shell/extensions/aiu-indicator/">
    <key name="refresh-interval" type="u">
      <range min="60" max="86400"/>
      <default>300</default>
      <summary>Refresh interval</summary>
      <description>Seconds between two background runs of aiu.</description>
    </key>
  </schema>
</schemalist>
