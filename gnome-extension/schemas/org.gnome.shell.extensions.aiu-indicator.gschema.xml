<!-- Settings of the panel itself. aiu's own settings (providers, key sources)
     stay in config.toml, read and written only through `aiu config`. -->
<schemalist>
  <schema id="org.gnome.shell.extensions.aiu-indicator"
          path="/org/gnome/shell/extensions/aiu-indicator/">
    <key name="panel-side" type="s">
      <choices><choice value="left"/><choice value="right"/></choices>
      <default>'right'</default>
      <summary>Side of the clock</summary>
      <description>Place the indicator to the left or right of the clock.</description>
    </key>
    <key name="panel-order" type="u">
      <range min="1" max="100"/>
      <default>1</default>
      <summary>Order from the clock</summary>
      <description>Rank on the chosen side, counting away from the clock. One is closest. Positions beyond the available buttons use the outermost slot.</description>
    </key>
    <key name="refresh-interval" type="u">
      <range min="60" max="86400"/>
      <default>300</default>
      <summary>Refresh interval</summary>
      <description>Seconds between two background runs of aiu.</description>
    </key>
  </schema>
</schemalist>
